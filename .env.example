# Copy to .env; keys are loaded by the server and never included in the browser bundle.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# Prosody can incur additional charges. Only enable after checking your Azure resource pricing.
AZURE_ENABLE_PROSODY=false
# Optional article TTS Python executable. Defaults to .venv-tts, then python on PATH.
# TTS_PYTHON=
